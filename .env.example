# ==============================================================================
# VerityAI - Environment Configuration Template
# Copy this file to .env and populate with appropriate values.
# NEVER commit .env or any secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME=VerityAI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Firebase Admin SDK & Firestore Configuration (Backend)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./secrets/service-account.json

# ------------------------------------------------------------------------------
# Google Gemini API (Phase 3+)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# ChromaDB Vector Store Configuration (Phase 4+)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=verity_knowledge_base

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# Firebase Web Client Configuration (Frontend)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
