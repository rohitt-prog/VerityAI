# ------------------------------------------
chromadb/
chroma_data/
*.chroma
chroma.sqlite3
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Logs and Run-time Artifacts
# ------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# OS Metadata & Google Drive Artifacts
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon\r\r
# Google Drive sync artifacts
.tmp.drive*
*.tmp
~*

# ------------------------------------------
# IDE & Editor Settings
# ------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
